{
  "name": "alefba-ai-model-lab",
  "version": "0.5.0",
  "private": true,
  "description": "Offline, source-backed and interactive laboratory for learning, simulating and designing AI systems",
  "license": "MIT",
  "author": "Danial Samiei / alef.ba International Research Program",
  "homepage": "https://github.com/danialsamiei/alefba-ai-model-lab#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/danialsamiei/alefba-ai-model-lab.git",
    "directory": "reasoning-lab/desktop"
  },
  "bugs": {
    "url": "https://github.com/danialsamiei/alefba-ai-model-lab/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite",
    "dev": "npm run build:web && electron .",
    "build:web": "vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build:web",
    "dist:win": "npm run check && electron-builder --win portable --x64",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource-variable/noto-kufi-arabic": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "ba.alef.research.ai.model.lab",
    "productName": "Alefba AI Model Lab",
    "copyright": "Copyright © 2026 Danial Samiei",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/licenses",
        "to": "licenses",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "compression": "maximum",
    "artifactName": "Alefba-AI-Model-Lab-${version}-Windows-${arch}.${ext}",
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "legalTrademarks": "Model names remain trademarks of their respective owners."
    }
  }
}
